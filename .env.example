# Gemini raw-audio inference
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low

# Evaluator login. Replace every default in deployed environments.
DASHBOARD_USERNAME=evaluator
DASHBOARD_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=43200

# Batch/runtime controls
BATCH_CONCURRENCY=3
MAX_AUDIO_BYTES=20971520
MAX_BATCH_UNCOMPRESSED_BYTES=104857600

# Comma-separated dashboard origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
