# Gemini semantic and selected raw-audio inference
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low

# Customer-segment acoustic-affect service
EMOTION_SERVICE_URL=https://mbakajoe26--autoace-emotion-service-emotionmodel-predict.modal.run
EMOTION_SERVICE_TIMEOUT_SECONDS=240

# Experimental emotion pipeline: Groq Whisper -> NVIDIA Nemotron
# These are used only by scripts/evaluate_hybrid_emotion.py until the approach is validated.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TIMEOUT_SECONDS=180
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_TIMEOUT_SECONDS=180

# Experimental transcript + raw-audio fusion path.
FUSION_GROQ_MODEL=whisper-large-v3-turbo
FUSION_GEMINI_MODEL=gemini-3.5-flash-lite

# Production diarization, transcript, audio-event, overlap, and silence evidence
ELEVENLABS_API_KEY=
ELEVENLABS_SCRIBE_MODEL=scribe_v2
ELEVENLABS_TIMEOUT_SECONDS=180
SCRIBE_OVERLAP_MIN_SECONDS=0.05
PERSISTENT_NOISE_SECONDS=2
LONG_SILENCE_THRESHOLD_SECONDS=12

# Hosted expression/prosody diagnostic. No local ML model is required.
HUME_API_KEY=
HUME_HTTP_TIMEOUT_SECONDS=120
HUME_JOB_TIMEOUT_SECONDS=300
HUME_POLL_SECONDS=3

# Evaluator login. Replace every default in deployed environments.
DASHBOARD_USERNAME=evaluator
DASHBOARD_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=43200

# Batch/runtime controls
BATCH_CONCURRENCY=3
MAX_AUDIO_BYTES=20971520
MAX_BATCH_UNCOMPRESSED_BYTES=104857600

# Comma-separated dashboard origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
